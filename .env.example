# Plantilla de configuración. Este archivo SÍ se versiona; el real se llama ".env"
# (sin ".example"), lleva las claves de verdad y NUNCA se sube.
#
# Para crear el tuyo:   copy .env.example .env   (Windows)

# OBLIGATORIA. LLM en Groq. Se saca de https://console.groq.com/keys
GROQ_API_KEY=gsk-reemplazá-esto-por-tu-clave-real

# Modelo de lenguaje. Groq rota su catálogo: https://console.groq.com/docs/models
MODELO=openai/gpt-oss-120b

# Modelo de embeddings, local. Si lo cambiás, BORRÁ artifacts/ y reindexá:
# un índice solo sirve con el modelo que lo generó.
MODELO_EMBEDDINGS=BAAI/bge-m3

# Dónde corren los embeddings: "cuda" (GPU) o "cpu".
DISPOSITIVO_EMBEDDINGS=cuda
